# Supabase Auth and database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
# Match: embeddings deployment (distinct from the CV chat model)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
MATCH_DEADLINE_SECONDS=75
MATCH_EMBEDDINGS_TIMEOUT_SECONDS=20
MATCH_LLM_TIMEOUT_SECONDS=45
MATCH_CANDIDATES_K=8

# Argentina job search (server only; obtain a regional key from ar.jooble.org)
JOOBLE_AR_API_KEY=

# LinkedIn via Apify (server only; token from console.apify.com/settings/integrations)
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=bebity/linkedin-jobs-scraper
APIFY_MAX_CHARGE_USD=0.10
APIFY_RUN_TIMEOUT_SECONDS=180
APIFY_MAX_ITEMS=20
APIFY_WEBHOOK_SECRET=

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
