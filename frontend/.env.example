# Public browser configuration only. Backend URL is optional for same-domain Vercel Services.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# En Vercel con vercel.json (frontend y backend juntos), dejar esta variable
# vacía u omitirla para usar /api en el mismo dominio. No usar localhost.
